# QNM Analyser — environment template
# Author: Dr. Denys Dutykh (https://www.denys-dutykh.com/)
#
# Copy to .env on the server and fill in.  .env is gitignored and is sourced by
# start.sh and webhook_start.sh, so treat it as shell: no unquoted backticks or
# $(...) unless you mean them to execute.

# --- Webhook receiver -------------------------------------------------------
# Shared secret configured on the GitHub webhook. Generate with:
#   openssl rand -hex 32
# If unset, every webhook request is rejected (fail closed).
WEBHOOK_SECRET=
# Loopback port for the webhook receiver.
WEBHOOK_PORT=9050

# --- Deployment paths -------------------------------------------------------
APP_DIR=/home/dds/www/qnm-analyser
VENV_DIR=/home/dds/www/qnm-analyser/venv
GIT_REMOTE=origin
GIT_BRANCH=main
PM2_APP=qnm-analyser

# --- Gunicorn (optional overrides; see gunicorn_conf.py) --------------------
# GUNICORN_BIND=127.0.0.1:8050
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_LOGLEVEL=info

# --- Numerical libraries ----------------------------------------------------
# One BLAS thread per worker; start.sh defaults these to 1.
# OMP_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1
